ORGANIZER_BOT_TOKEN=replace-with-organizer-token
PARTICIPANT_BOT_TOKEN=replace-with-participant-token
PARTICIPANT_BOT_USERNAME=replace_without_at
DATABASE_URL=sqlite+aiosqlite:///./meetifier.db
# UTC offset in hours (integer). Examples: 0=UTC, 1=UTC+1, 3=UTC+3, -5=UTC-5
DEFAULT_TIMEZONE=0
POLL_TIMEOUT_SECONDS=20
WORKER_INTERVAL_SECONDS=5

# Optional Google Calendar import + export sync (organizer only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/oauth/google/callback
OAUTH_HOST=127.0.0.1
OAUTH_PORT=8080
GOOGLE_SYNC_INTERVAL_SECONDS=60
