ORGANIZER_BOT_TOKEN=replace-with-organizer-token
PARTICIPANT_BOT_TOKEN=replace-with-participant-token
PARTICIPANT_BOT_USERNAME=replace_without_at
DATABASE_URL=sqlite+aiosqlite:///./meetifier.db
# Used by compose.yaml. Use a URL-safe value, for example: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Public hostname used by the optional Caddy production profile.
MEETIFIER_DOMAIN=calendar.example.com
# UTC offset in hours (integer). Examples: 0=UTC, 1=UTC+1, 3=UTC+3, -5=UTC-5
DEFAULT_TIMEZONE=0
POLL_TIMEOUT_SECONDS=20
WORKER_INTERVAL_SECONDS=5

# Optional Google Calendar import + export sync (organizer only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production example: https://calendar.example.com/oauth/google/callback
GOOGLE_REDIRECT_URI=
# Generate once and keep stable: python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Use 127.0.0.1 for a host process; compose.yaml overrides this to 0.0.0.0 inside the container.
OAUTH_HOST=127.0.0.1
OAUTH_PORT=8080
OAUTH_STATE_TTL_SECONDS=900
GOOGLE_SYNC_INTERVAL_SECONDS=60
